!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env
.env.local
.env.production

# Carpetas de Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dependencias (Ya lo tienes, pero confirmamos)
node_modules/

# Carpetas de construcción de Next.js (¡Muy importante!)
.next/
out/
build/

# Todas las posibles variables de entorno
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archivos de registro de errores (Logs)
npm-debug.log*
yarn-debug.log*
